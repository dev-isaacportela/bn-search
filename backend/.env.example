# Auto-populado pelo servidor (sandbox do Mitra) — NÃO hardcode valores.
# Localmente estas chaves ficam VAZIAS: o simulador não precisa delas e o
# mitra-sdk só é executado no sandbox (ver references/publicacao.md).
MITRA_BASE_URL=
MITRA_BASE_URL_INTEGRATIONS=
MITRA_TOKEN=
MITRA_PROJECT_ID=
MITRA_WORKSPACE_ID=

# WinThor (Oracle, JDBC externo) — add-001-jdbc-winthor.mjs. Preenchido só no
# .env do sandbox (ou da máquina com acesso ao Oracle); nunca commitado.
WINTHOR_JDBC_URL=
WINTHOR_USER=
WINTHOR_PASSWORD=

# Busca 360 (fotos dos produtos) — add-004-fotos.mjs grava esta chave em
# CW_FOTOS_CONFIG. Preenchida só no .env do sandbox; nunca commitada e nunca
# em variável VITE_* (iria para o bundle público).
BUSCA360_CHAVE=

# Simulador: com `oracle`, as cw* leem o WinThor REAL (credenciais acima) em
# vez das PC* imitadas no SQLite. Vazio = SQLite, o padrão; check e smoke
# ignoram esta chave. Precisa do Oracle Instant Client (ORACLE_CLIENT_LIB_DIR).
SIMULATOR_WINTHOR=
ORACLE_CLIENT_LIB_DIR=
